# NextaLeadMap environment. The web installer writes .env for you; it is never overwritten by updates.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://leads.example.com
# 32 random bytes, base64. Encrypts provider credentials. NEVER change after install (data becomes unreadable).
APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nextaleadmap
DB_USERNAME=nextaleadmap
DB_PASSWORD=
DB_PREFIX=nlm_
# Optional: CA bundle path to require TLS for a remote database (not needed for localhost on cPanel).
DB_SSL_CA=
# Optional: require this token on the installer page (?token=...) when installing on a public server.
INSTALL_TOKEN=
# Set to 1 behind a trusted reverse proxy / Cloudflare to honour X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=0
