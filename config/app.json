{
    "app": {
        "name": "NextaLeadMap",
        "company": "Nexta Web Solution",
        "timezone": "Asia/Kolkata",
        "per_page": 25,
        "default_lang": "en",
        "default_country": "in"
    },
    "security": {
        "session_idle_minutes": 60,
        "session_absolute_hours": 12,
        "login_max_attempts": 5,
        "login_window_minutes": 15,
        "password_min_length": 10,
        "api_rate_limit_per_minute": 60,
        "web_rate_limit_per_minute": 300,
        "job_create_per_hour": 30,
        "force_https": false,
        "audit_retention_days": 365
    },
    "providers": {
        "default": "google_places",
        "timeout": 30,
        "max_retries": 3,
        "use_proxies": false,
        "google_places": { "enabled": true },
        "serpapi": { "enabled": false }
    },
    "geocoding": {
        "provider": "nominatim",
        "nominatim_url": "https://nominatim.openstreetmap.org",
        "contact_email": "",
        "city_radius_km": 12
    },
    "enrichment": {
        "workers": 8,
        "timeout": 10,
        "hard_timeout": 25,
        "max_bytes": 400000,
        "contact_pages": 2,
        "use_proxies": false,
        "user_agent": "Mozilla/5.0 (compatible; NextaLeadMap/1.0; +https://nextawebsolution.com)",
        "extra_junk_domains": []
    },
    "jobs": {
        "max_keywords": 100,
        "max_time_default": 900,
        "max_time_limit": 7200,
        "max_results_cap": 500,
        "grid_max": 6,
        "worker_max_runtime": 55,
        "stale_minutes": 5,
        "max_attempts": 3
    },
    "updates": {
        "server_url": "",
        "auto_check": true,
        "max_package_mb": 100
    },
    "backup": {
        "keep": 5
    }
}
